# Port server aplikasi
APP_PORT=8080

# URL koneksi database PostgreSQL
# Format: postgres://username:password@host:port/database_name?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/habit_tracker?sslmode=disable

# Rahasia tanda tangan JWT (ganti dengan string acak aman)
SESSION_SECRET=supersecretjwtkey_replace_in_production

